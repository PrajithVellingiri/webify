{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://webify-backend.onrender.com/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://webify-backend.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
