# ==========================================
# WEBIFY INVENTORY SYSTEM — ENVIRONMENT CONFIG
# ==========================================

# MongoDB Connection String (Atlas or self-hosted)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/webify?retryWrites=true&w=majority

# JWT Secret for authentication signing (use a strong random string)
JWT_SECRET=your_jwt_secret_key_at_least_32_chars_long

# Express Server Port (Render sets this dynamically)
PORT=5000

# Optional: Vercel or custom frontend URL for CORS when decoupled
FRONTEND_URL=https://your-app.vercel.app

# Node Environment
NODE_ENV=production
